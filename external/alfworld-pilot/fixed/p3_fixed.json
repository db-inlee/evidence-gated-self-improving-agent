{
  "ticket": "Ticket 008",
  "fixed_on": "2026-11-01",
  "criteria": {
    "G1": {
      "rule": "잠금 파일로 새 환경을 만들고 텍스트 게임 하나를 끝까지 돈다. conda가 필요하면 조건부"
    },
    "G2": {
      "rule": "풀에서 유형마다 3~4개, 모두 20개, 리셋 3회: 첫 관측과 가능한 명령 목록이 순서까지 같고, 같은 행동 열이면 같은 관측 열"
    },
    "G3": {
      "formula": [
        "d_c = 칸 c의 S0 반복 쌍 불일치율(3쌍 평균)",
        "d_hat_c = max(d_c, d_floor)",
        "n_O,c = ceil(z^2 * d_hat_c / (h/2)^2)",
        "n_B,c = ceil(n_O,c * n_B_ratio)",
        "n_min = max_c (n_A + n_B,c + n_O,c)",
        "통과: 모든 유형에서 (train - 파일럿 게임 수) >= n_min"
      ],
      "constants": {
        "z": 1.96,
        "h": 0.2,
        "d_floor": 0.1,
        "n_B_ratio": "35/50",
        "n_A": 10
      }
    },
    "G4": {
      "rule": "S0 성공률(반복 평균의 점추정)이 range 안인 유형이 min_cells개 이상. 칸별 Clopper-Pearson 구간을 함께 보고",
      "constants": {
        "range": [
          0.15,
          0.85
        ],
        "min_cells": 4,
        "cells": 6
      }
    },
    "G5": {
      "formula": [
        "T_009 = E_009 * s_bar * margin",
        "s_bar = P3·P4의 평균 처리량(초/에피소드, 실제 동시 수, 실제 벽시계)",
        "E_009 = 후보 수 * (Dev-A + Dev-B + Oracle 칸 합) + S0 반복",
        "통과: T_009 <= B_009"
      ],
      "constants": {
        "margin": 1.1,
        "candidates": 40,
        "B_009_days": 7
      }
    },
    "G6": {
      "formula": [
        "Delta_t = 표적 칸 게임 집합 G에서 (탐침 1회 성공 - S0 반복 3회 다수결)의 게임 평균",
        "잡음: G를 복원 추출(|G|개)하고 매번 S0 반복 하나 r을 골라 (S0_r - 다수결)의 게임 평균",
        "q_lo, q_hi = 잡음 분포의 percentiles",
        "통과: 표적 칸 Delta_t < q_lo 그리고 비표적 칸마다 Delta가 [q_lo, q_hi] 안",
        "중립·전체 도움 탐침은 기술만 하고 판정에 넣지 않는다"
      ],
      "constants": {
        "resamples": 2000,
        "seed": 0,
        "percentiles": [
          2.5,
          97.5
        ],
        "resample_index": "evidencegate.exact 층화 재표본 색인"
      }
    },
    "overall": [
      "G1~G6 모두 통과: Go",
      "G3나 G5만 미달이고 축소 설계로 B_009 안: 조건부 Go",
      "G1이 조건부(conda)이고 나머지 통과: 조건부 Go",
      "그 밖: No-Go"
    ],
    "budget": {
      "B_009_days": 7,
      "pilot_hours": 12
    }
  },
  "evidence": {
    "E-a": {
      "step": "성공한 `take X from R`마다, 그 걸음 이전 관측(첫 관측 포함) 중에 R 안·위에 X가 보이는 문장이 있었는가",
      "episode": "won 그리고 성공한 take가 하나 이상 그리고 모두 걸음 판정 충족",
      "patterns": {
        "on": "On the (?P<r>[a-z]+ \\d+), you see (?P<items>[^.]*)\\.",
        "in_it": "(?:You open the |The )(?P<r>[a-z]+ \\d+)(?: is open)?\\.\\s+(?:The (?P=r) is open\\.\\s+)?In it, you see (?P<items>[^.]*)\\.",
        "take_command": "^take (?P<o>[a-z]+ \\d+) from (?P<r>[a-z]+ \\d+)$",
        "item": "^(?:and )?(?:a |an )?(?P<o>[a-z]+ \\d+)$",
        "take_success": "You pick up the {X} from the {R}.",
        "not_contents": [
          "you see nothing.",
          "Looking quickly around you, you see ..."
        ]
      }
    },
    "E-b": {
      "rule": "실행된 걸음 중 행동이 직전 가능한 명령 목록에 있던 비율. 형식 오류 턴은 세지 않고 형식 오류 수는 따로 기록. 보조 기록, Evidence-Safe 대응 아님"
    },
    "E-c": {
      "rule": "won 그리고 걸음 수 <= k * L_expert. 비율(걸음 수 / L_expert) 분포도 보고. 성공에만 정의되는 한계를 적는다",
      "k": 2,
      "L_expert": "records/p1_expert.json의 성공 걸음 수(전문가 시드 0, PYTHONHASHSEED=0)",
      "undefined_when": "전문가가 그 게임을 150걸음 안에 못 풀었을 때"
    },
    "conclusion_rule": {
      "base_rate_range": [
        0.15,
        0.85
      ],
      "min_share_of_wins_failing_e_a": 0.05
    },
    "conclusion_text": "S0 기준률이 base_rate_range 밖이면 바닥·천장. 성공한 에피소드 중 E-a 불성립 비율이 min_share 미만이면 성공과 다른 정보 없음. 둘 다 아니면 E-a를 쓴다. 아니면 대응 지표 없음, 주 지표만"
  },
